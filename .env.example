# Copie para .env e preencha. Nunca commite o .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL local (não publique a porta do banco).
DATABASE_URL=postgres://brain:troque-esta-senha@127.0.0.1:5432/brain_dev
TEST_DATABASE_URL=postgres://brain:troque-esta-senha@127.0.0.1:5432/brain_test

# Gere com: openssl rand -base64 32
BETTER_AUTH_SECRET=troque-por-um-segredo-de-32-caracteres-ou-mais

# Origem estável usada no browser. Em dev, a origem do Vite.
BETTER_AUTH_URL=http://127.0.0.1:5173
BRAIN_PUBLIC_ORIGIN=http://127.0.0.1:5173

# Só habilite trust proxy com a lista explícita de proxies confiáveis.
BRAIN_TRUST_PROXY=false
BRAIN_TRUSTED_PROXIES=
BRAIN_SECURE_COOKIES=false
BRAIN_SETUP_TOKEN_TTL_HOURS=24

# Compose: defina POSTGRES_PASSWORD e as mesmas variáveis de origem/segredo.
# POSTGRES_PASSWORD=troque-esta-senha
# BRAIN_PORT=3000
